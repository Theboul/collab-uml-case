# ==========================================
# SchemaCraft Backend - Variables de Entorno
# ==========================================

# 1. Google OAuth 2.0 / OpenID Connect Client ID
# Obténlo en Google Cloud Console: APIs & Services -> Credentials -> OAuth 2.0 Client IDs (Tipo: Web Application)
# Asegúrate de agregar en "Authorized JavaScript origins": http://localhost:4200 y http://127.0.0.1:4200
GOOGLE_CLIENT_ID=

# 2. Clave secreta JWT para la firma de Access Tokens (HS256)
JWT_SECRET=schemacraft_super_secret_jwt_key_2026_dev_only

# 3. Base de Datos (Opcional - Si se deja vacío o no configurado usa SQLite local aiosqlite en ./shared_case.db)
# Ejemplo para PostgreSQL: postgresql+psycopg://usuario:password@localhost:5432/schemacraft_db
DATABASE_URL=sqlite+aiosqlite:///./shared_case.db

# 4. Redis (Opcional - para WebSockets multi-worker)
# REDIS_URL=redis://localhost:6379/0
