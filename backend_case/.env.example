# ==========================================
# SchemaCraft Backend - Variables de Entorno
# ==========================================

# 1. Google OAuth 2.0 / OpenID Connect Client ID
# Obténlo en Google Cloud Console: APIs & Services -> Credentials -> OAuth 2.0 Client IDs (Tipo: Web Application)
# Asegúrate de agregar en "Authorized JavaScript origins": http://localhost:4200 y http://127.0.0.1:4200
GOOGLE_CLIENT_ID=

# 2. Clave secreta JWT para la firma de Access Tokens (HS256). OBLIGATORIA: la app no arranca sin ella.
# Genera una con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# 3. Base de Datos (Opcional - Si se deja vacío o no configurado usa SQLite local aiosqlite en ./shared_case.db)
# Ejemplo para PostgreSQL: postgresql+psycopg://usuario:password@localhost:5432/schemacraft_db
DATABASE_URL=sqlite+aiosqlite:///./shared_case.db

# 4. Redis (Opcional - para WebSockets multi-worker)
# REDIS_URL=redis://localhost:6379/0

# 5. Google Gemini API Key (CU6/CU7 - chatbot y análisis de imagen UML)
# Obténla en Google AI Studio: https://aistudio.google.com/apikey
# Sin esta variable, las llamadas reales a Gemini fallan (clave vacía) -- los tests
# automatizados no la necesitan porque mockean call_gemini().
GEMINI_API_KEY=

# 6. URL del generador Spring Boot real (CU10 -- back_generator_uml, Java/Maven)
# Mismo despliegue que ya usa el frontend legacy (ver environment.ts -- endpoint_java).
# Sin esta variable, se usa el despliegue público por defecto.
GENERATOR_SPRING_URL=https://spring-sw1.fournext.me
